{
  "name": "mpcoach",
  "version": "0.0.1",
  "private": true,
  "description": "MPCoach — piattaforma one-to-one coaching chitarra di Marco Petta (metodo P.G.T.)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@mpcoach/web",
    "build:web": "npm run build --workspace=@mpcoach/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
